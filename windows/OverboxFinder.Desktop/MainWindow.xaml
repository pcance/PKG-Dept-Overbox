<Window x:Class="OverboxFinder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Overbox Finder - WPF Preview" Height="740" Width="1100" MinHeight="640" MinWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14" CornerRadius="8" Background="#FF1D4ED8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Overbox Finder (Windows Native Migration)" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="This WPF shell is the first migration step away from the hosted/local web app." Foreground="#FFE0E7FF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="1" Header="CSV Source + Local Cache" Margin="0,0,0,12" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="SharePoint folder URL:"/>
                <TextBox x:Name="SharePointUrlTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="CSV source folder:"/>
                <TextBox x:Name="SourceFolderTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Local cache folder:"/>
                <TextBox x:Name="CacheFolderTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save Settings" Padding="14,6" Margin="0,0,8,0" Click="SaveSettings_Click"/>
                    <Button Content="Refresh Cache From Source" Padding="14,6" Background="#FF2563EB" Foreground="White" Click="RefreshCache_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="CSV File Status" Padding="8" Margin="0,0,12,0">
                <DataGrid ItemsSource="{Binding CsvStatuses}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File" Binding="{Binding LogicalFile}" Width="140"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                        <DataGridTextColumn Header="Source Path" Binding="{Binding SourcePath}" Width="*"/>
                        <DataGridTextColumn Header="Cache Path" Binding="{Binding CachePath}" Width="*"/>
                        <DataGridTextColumn Header="Cache Modified" Binding="{Binding CacheModifiedUtc}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Overbox Workflow (Next Migration Step)" Padding="10">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="This panel marks the planned native replacement for the current web flow (site selection, item input, and solve output)."/>

                    <TextBlock Text="Site" FontWeight="SemiBold"/>
                    <ComboBox Margin="0,6,0,12" SelectedIndex="0">
                        <ComboBoxItem Content="Penang"/>
                        <ComboBoxItem Content="Debrecen"/>
                        <ComboBoxItem Content="Global"/>
                    </ComboBox>

                    <Button Content="Open Local Cache Folder" Padding="10,6" Margin="0,0,0,8" Click="OpenCacheFolder_Click"/>
                    <Button Content="Run Overbox Finder (coming next)" Padding="10,6" IsEnabled="False"/>

                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#FF4B5563"
                               Text="Next step: port CSV lookup + solver workflow from backend/frontend into strongly-typed WPF view models and services."/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <Border Grid.Row="3" Padding="8" Background="#FFF3F4F6" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="Ready"/>
        </Border>
    </Grid>
</Window>
